{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contribution envelope (<pack>/extensions/<point>/<key>.yaml); point fields are checked against the point's schema",
  "type": "object",
  "required": ["api", "summary", "example", "effects"],
  "properties": {
    "api": {"type": "integer", "minimum": 1},
    "name": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[^\\n\\r]*$"},
    "example": {"type": "string", "minLength": 1},
    "entry": {"type": "string", "minLength": 1},
    "version": {"type": ["string", "integer"]},
    "status": {"enum": ["active", "experimental", "deprecated"]},
    "deprecated": {
      "type": "object",
      "required": ["since"],
      "additionalProperties": false,
      "properties": {
        "since": {"type": "string"},
        "use": {"type": "string"},
        "remove_after": {"type": "string"}
      }
    },
    "budget": {"type": "object"},
    "effects": {"type": ["string", "object"]},
    "compatibility": {"type": "string"}
  }
}
