[Unit]
Description=Astrid Blender Render API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/astrid-blender-render
Environment=PYTHONUNBUFFERED=1
Environment=BLENDER_EXEC=/usr/bin/blender
Environment=BLENDER_RENDER_HOST=127.0.0.1
Environment=BLENDER_RENDER_PORT=8778
Environment=BLENDER_RENDER_CONCURRENCY=2
# A non-loopback BLENDER_RENDER_HOST requires BLENDER_RENDER_TOKEN; deploy.py writes both.
# Environment=BLENDER_RENDER_TOKEN=change-me
ExecStart=/usr/bin/python3 /opt/astrid-blender-render/blender_render_server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
