#!/usr/bin/env python3
"""Fail when files still contain names retired by the Astrid rename."""

from __future__ import annotations

import argparse
import fnmatch
import os
import re
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path
from typing import Iterable, Sequence


HERE = Path(__file__).resolve().parent
MAP_PATH = HERE / "rename-map.tsv"
DEFAULT_KEPT = HERE / "kept-banodoco.txt"
FIXED_PATTERNS: tuple[tuple[str, bool], ...] = (
    (r"reigh", False),
    (r"banodoco[-_]workspace[-_](runtime|client)", False),
    (r"banodoco_workspace", False),
    (r"banodoco[ _-](local|runtime)", False),
    (r"@banodoco/workspace-client", False),
    (r"Application Support/Banodoco", False),
    (r"Banodoco Workspace", False),
    (r"peteromallet/Astrid(?!-agent)", False),
    (r"\w*BANODOCO_", True),
    (r"/Astrid-agent", True),
)
STRICT_PATTERN = re.compile(r"banodoco", re.IGNORECASE)
REPO_ALIASES = {
    "astrid-agent": "astrid",
    "astrid": "astrid",
    "reigh-app": "app",
    "astrid-app": "app",
    "banodoco-workspace-runtime": "runtime",
    "astrid-runtime": "runtime",
}


class CheckError(Exception):
    pass


@dataclass(frozen=True)
class Hit:
    path: str
    line: int
    match: str


def read_list(path: Path) -> list[str]:
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError as exc:
        raise CheckError(f"cannot read list {path}: {exc}") from exc
    entries: list[str] = []
    for line in lines:
        entry = line.split("#", 1)[0].strip().replace("\\", "/")
        if entry:
            entries.append(entry.lstrip("./"))
    return entries


def list_matches(relative_path: str, entries: Sequence[str]) -> bool:
    relative_path = relative_path.replace("\\", "/").lstrip("./")
    for entry in entries:
        entry = entry.replace("\\", "/").lstrip("./")
        if entry.endswith("/"):
            directory = entry[:-1]
            if relative_path == directory or relative_path.startswith(directory + "/"):
                return True
        elif fnmatch.fnmatchcase(relative_path, entry):
            return True
    return False


def absolute_paths(inputs: Sequence[str]) -> list[Path]:
    paths = [Path(value).expanduser().absolute() for value in inputs]
    for path in paths:
        if not path.exists():
            raise CheckError(f"path does not exist: {path}")
    return paths


def root_and_files(inputs: Sequence[str]) -> tuple[Path, list[Path]]:
    paths = absolute_paths(inputs)
    anchors = [path if path.is_dir() and not path.is_symlink() else path.parent for path in paths]
    root = Path(os.path.commonpath([str(path) for path in anchors])).resolve()
    files: set[Path] = set()
    for path in paths:
        if path.is_symlink():
            files.add(path)
        elif path.is_file():
            files.add(path)
        elif path.is_dir():
            for directory, dirnames, filenames in os.walk(path, followlinks=False):
                dirnames[:] = sorted(
                    name for name in dirnames if name != ".git" and not (Path(directory) / name).is_symlink()
                )
                for filename in filenames:
                    files.add(Path(directory) / filename)
    return root, sorted(files, key=lambda path: path.as_posix())


def git_root(path: Path) -> Path:
    result = subprocess.run(
        ["git", "-C", str(path), "rev-parse", "--show-toplevel"],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    if result.returncode:
        raise CheckError(f"{path}: not inside a git repository")
    return Path(result.stdout.strip()).resolve()


def git_files(root: Path) -> list[Path]:
    result = subprocess.run(
        ["git", "-C", str(root), "ls-files", "--cached", "--others", "--exclude-standard", "-z"],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if result.returncode:
        message = result.stderr.decode("utf-8", errors="replace").strip()
        raise CheckError(f"{root}: git ls-files failed: {message}")
    return sorted(
        (root / os.fsdecode(item) for item in result.stdout.split(b"\0") if item),
        key=lambda path: path.as_posix(),
    )


def repo_key_from_origin(root: Path) -> str | None:
    result = subprocess.run(
        ["git", "-C", str(root), "remote", "get-url", "origin"],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    if result.returncode:
        return None
    leaf = result.stdout.strip().rstrip("/").rsplit("/", 1)[-1].removesuffix(".git").lower()
    return REPO_ALIASES.get(leaf)


def map_workspace_runtime_rows() -> list[tuple[str, str]]:
    if not MAP_PATH.exists():
        return []
    try:
        lines = MAP_PATH.read_text(encoding="utf-8").splitlines()
    except OSError as exc:
        raise CheckError(f"cannot read map {MAP_PATH}: {exc}") from exc
    if not lines or lines[0].split("\t") != ["kind", "old", "new", "scope", "note"]:
        return []
    hits: list[tuple[str, str]] = []
    for line in lines[1:]:
        cells = line.split("\t")
        if len(cells) == 5 and cells[1].casefold() == "workspace-runtime":
            hits.append((cells[0], cells[3]))
    return hits


def row_scope_applies(scope: str, repo: str | None, relative: str) -> bool:
    if scope == "all":
        return True
    if scope in {"astrid", "runtime", "app"}:
        return repo == scope
    if ":" in scope:
        expected_repo, glob = scope.split(":", 1)
        return repo == expected_repo and fnmatch.fnmatchcase(relative, glob)
    return False


def compile_kept(path: Path) -> list[re.Pattern[str]]:
    if not path.exists():
        raise CheckError(f"kept-form list does not exist: {path}")
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError as exc:
        raise CheckError(f"cannot read kept forms {path}: {exc}") from exc
    patterns: list[re.Pattern[str]] = []
    for lineno, line in enumerate(lines, 1):
        expression = line.split("#", 1)[0].strip()
        if not expression:
            continue
        try:
            patterns.append(re.compile(expression, re.IGNORECASE))
        except re.error as exc:
            raise CheckError(f"{path}:{lineno}: invalid kept-form regex: {exc}") from exc
    return patterns


def matching_spans(line: str, profile: str, kept: Sequence[re.Pattern[str]], key_rows: Sequence[tuple[str, str]], repo: str | None, relative: str) -> list[str]:
    matches: set[tuple[int, int, str]] = set()
    uppercase_env = list(re.finditer(r"\w*BANODOCO_", line))
    for expression, sensitive in FIXED_PATTERNS:
        if profile == "keep" and (expression == r"\w*BANODOCO_" or expression == r"/Astrid-agent"):
            continue
        pattern = re.compile(expression, 0 if sensitive else re.IGNORECASE)
        for match in pattern.finditer(line):
            if profile == "keep" and expression == r"banodoco[ _-](local|runtime)" and any(
                env.start() < match.end() and env.end() > match.start() for env in uppercase_env
            ):
                continue
            matches.add((match.start(), match.end(), match.group(0)))

    if profile != "keep":
        for match in STRICT_PATTERN.finditer(line):
            if not any(kept_match.start() <= match.start() and kept_match.end() >= match.end() for pattern in kept for kept_match in pattern.finditer(line)):
                matches.add((match.start(), match.end(), match.group(0)))

    for kind, scope in key_rows:
        if not row_scope_applies(scope, repo, relative):
            continue
        # N-MAP classifies this exact old repo key. Keep its check bounded so
        # protocol identifiers such as WORKSPACE_RUNTIME_URL are unaffected.
        pattern = re.compile(r"(?<![A-Za-z0-9_.-])workspace-runtime(?![A-Za-z0-9_.-])", re.IGNORECASE)
        for match in pattern.finditer(line):
            matches.add((match.start(), match.end(), match.group(0)))

    return [value for _, _, value in sorted(matches)]


def content_hits(path: str, text: str, profile: str, kept: Sequence[re.Pattern[str]], key_rows: Sequence[tuple[str, str]], repo: str | None, relative: str) -> list[Hit]:
    hits: list[Hit] = []
    for lineno, line in enumerate(text.splitlines(), 1):
        for match in matching_spans(line, profile, kept, key_rows, repo, relative):
            hits.append(Hit(path, lineno, match))
    return hits


def scan_files(
    root: Path,
    files: Iterable[Path],
    profile: str,
    kept: Sequence[re.Pattern[str]],
    key_rows: Sequence[tuple[str, str]],
    repo: str | None,
    allow_entries: Sequence[str],
) -> list[Hit]:
    hits: list[Hit] = []
    for path in files:
        try:
            relative = path.relative_to(root).as_posix()
        except ValueError:
            raise CheckError(f"{path}: not under scan root {root}")
        if ".git/" in relative or relative == ".git" or list_matches(relative, allow_entries):
            continue
        path_matches = matching_spans(relative, profile, kept, key_rows, repo, relative)
        hits.extend(Hit(relative, 0, value) for value in path_matches)
        if path.is_symlink() or not path.is_file():
            continue
        try:
            raw = path.read_bytes()
        except OSError as exc:
            raise CheckError(f"cannot read {path}: {exc}") from exc
        if b"\0" in raw[:8192]:
            continue
        text = raw.decode("utf-8", errors="surrogateescape")
        hits.extend(content_hits(relative, text, profile, kept, key_rows, repo, relative))
    return hits


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    source = parser.add_mutually_exclusive_group(required=True)
    source.add_argument("--repo", metavar="PATH")
    source.add_argument("--path", nargs="+", metavar="FILE_OR_DIR")
    source.add_argument("--stdin", action="store_true")
    parser.add_argument("--profile", choices=("main", "keep", "local"), default="main")
    parser.add_argument("--allow", metavar="FILE")
    parser.add_argument("--kept", metavar="FILE", default=str(DEFAULT_KEPT))
    return parser


def main(argv: Sequence[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    if args.profile == "local" and not args.path:
        parser.error("the local profile requires --path")
    try:
        kept = compile_kept(Path(args.kept).expanduser()) if args.profile != "keep" else []
        allow_entries = read_list(Path(args.allow).expanduser()) if args.allow else []
        key_rows = map_workspace_runtime_rows()
        if args.stdin:
            hits = content_hits("<stdin>", sys.stdin.read(), args.profile, kept, key_rows, None, "")
        elif args.repo:
            root = git_root(Path(args.repo).expanduser().absolute())
            repo = repo_key_from_origin(root)
            hits = scan_files(root, git_files(root), args.profile, kept, key_rows, repo, allow_entries)
        else:
            root, files = root_and_files(args.path)
            # --path is intended for local scans, but remains useful in tests
            # for each profile; no repository scope is assumed for this mode.
            hits = scan_files(root, files, args.profile, kept, key_rows, None, allow_entries)
    except (OSError, CheckError) as exc:
        print(f"check-zero: {exc}", file=sys.stderr)
        return 2

    for hit in hits:
        print(f"{hit.path}:{hit.line}:{hit.match}")
    return 1 if hits else 0


if __name__ == "__main__":
    raise SystemExit(main())
