        unetloader_2 = UNETLoader(unet_name=UNET_NAME)
        cliploader_2 = CLIPLoader(clip_name=CLIP_NAME, type=FLUX2)
        vaeloader_2 = VAELoader(vae_name=VAE_NAME)

        randomnoise_2 = RandomNoise(
