        # Inputs
        loadimage = LoadImage(image='handbag_white.png')
        loadimage_2 = LoadImage(image='comfy_logo_blue.png')

        imagescaletototalpixels_3 = ImageScaleToTotalPixels(
            upscale_method=NEAREST_EXACT,
            image=loadimage.out('IMAGE'),
        )

        # Conditioning
        cliptextencode_2 = CLIPTextEncode(
            text='Change the bag color to blue.',
            clip=cliploader_2.out('CLIP'),
        )

        imagescaletototalpixels = ImageScaleToTotalPixels(
            upscale_method=NEAREST_EXACT,
            image=loadimage_2.out('IMAGE'),
        )

        imagescaletototalpixels_2 = ImageScaleToTotalPixels(
            upscale_method=NEAREST_EXACT,
            image=loadimage.out('IMAGE'),
        )

        cliptextencode = CLIPTextEncode(
            text=DEFAULT_PROMPT,
            clip=cliploader.out('CLIP'),
        )

        getimagesize = GetImageSize(image=imagescaletototalpixels_3.out('IMAGE'))

        conditioningzeroout = ConditioningZeroOut(
            conditioning=cliptextencode_2.out('CONDITIONING'),
        )

        getimagesize_2 = GetImageSize(image=imagescaletototalpixels_2.out('IMAGE'))

        conditioningzeroout_2 = ConditioningZeroOut(
            conditioning=cliptextencode.out('CONDITIONING'),
        )

        vaeencode_2 = VAEEncode(
            pixels=imagescaletototalpixels_2.out('IMAGE'),
            vae=vaeloader.out('VAE'),
