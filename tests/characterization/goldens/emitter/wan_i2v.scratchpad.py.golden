from vibecomfy.nodes.core import CLIPLoader, CLIPTextEncode, CLIPVisionEncode, CLIPVisionLoader, CreateVideo, KSampler, LoadImage, ModelSamplingSD3, SaveVideo, UNETLoader, VAEDecode, VAELoader, WanImageToVideo


CLIP_NAME = 'umt5_xxl_fp8_e4m3fn_scaled.safetensors'
CLIP_NAME_2 = 'clip_vision_h.safetensors'
DEFAULT_FPS = 16
DEFAULT_FRAMES = 33
DEFAULT_PROMPT = 'a cute anime girl with massive fennec ears and a big fluffy tail wearing a maid outfit turning around'
DEFAULT_PROMPT_2 = '色调艳丽，过曝，静态，细节模糊不清，字幕，风格，作品，画作，画面，静止，整体发灰，最差质量，低质量，JPEG压缩残留，丑陋的，残缺的，多余的手指，画得不好的手部，画得不好的脸部，畸形的，毁容的，形态畸形的肢体，手指融合，静止不动的画面，杂乱的背景，三条腿，背景人很多，倒着走'
DEFAULT_SEED = 987948718394761
GUIDE_STRENGTH = 6
UNET_NAME = 'wan2.1_i2v_480p_14B_fp16.safetensors'
VAE_NAME = 'wan_2.1_vae.safetensors'
DEFAULT_IMAGE = 'image_to_video_wan_start_image.png'


PUBLIC_INPUT_METADATA = {
    'model': InputSpec(node=ref('unetloader'), field='unet_name', default=None, infer_type=False),
    'prompt': InputSpec(node=ref('cliptextencode'), field='text', default=DEFAULT_PROMPT, type='STRING', required=True, media_semantics='text', infer_type=False),
    'seed': InputSpec(node=ref('ksampler'), field='seed', default=DEFAULT_SEED, type='INT', infer_type=False),
    'steps': InputSpec(node=ref('ksampler'), field='steps', default=None, infer_type=False),
    'image': InputSpec(node=ref('loadimage'), field='image', default=DEFAULT_IMAGE, type='IMAGE', required=True, aliases=('input_image',), media_semantics='image', infer_type=False),
    'fps': InputSpec(node=ref('createvideo'), field='fps', default=DEFAULT_FPS, type='FLOAT', infer_type=False),
    'negative_prompt': InputSpec(node=ref('cliptextencode_2'), field='text', default=DEFAULT_PROMPT_2, type='STRING', aliases=('negative',), media_semantics='text', infer_type=False),
}


READY_METADATA = ReadyMetadata.build(
    capability='video',
    template_id='video/wan_i2v',
    inputs=PUBLIC_INPUT_METADATA,
    requirements={'models': ['clip_vision_h.safetensors', 'umt5_xxl_fp8_e4m3fn_scaled.safetensors', 'wan2.1_i2v_480p_14B_fp16.safetensors', 'wan_2.1_vae.safetensors']},
    source_path='ready_templates/sources/official/video/wan_i2v.json',
    source_id='video/wan_i2v',
    upstream_source_id='wan_i2v',
