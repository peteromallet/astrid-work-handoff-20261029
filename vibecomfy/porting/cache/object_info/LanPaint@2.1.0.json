        "audio_vae": ["VAE"],
        "mask": ["MASK"],
        "audio_mask": ["MASK"],
        "blend_overlap": ["INT", {"default": 11, "min": 1, "max": 51, "step": 2}],
        "audio_crossfade": ["FLOAT", {"default": 0.02, "min": 0.0, "max": 1.0, "step": 0.005}]
      }
    },
    "input_order": {"required": ["samples", "video", "vae", "audio_vae", "mask", "audio_mask", "blend_overlap", "audio_crossfade"]},
    "input_order_all": ["samples", "video", "vae", "audio_vae", "mask", "audio_mask", "blend_overlap", "audio_crossfade"],
    "object_info_widget_order": ["blend_overlap", "audio_crossfade"],
    "outputs": [{"type": "VIDEO", "name": "video", "is_list": false}, {"type": "AUDIO", "name": "audio", "is_list": false}],
    "function": "decode",
    "source_sha256": "d9bf9bccbb68ad0504b4be753c4dcb61164b0cf342dc59f1f87f0f0040f80334"
  },
