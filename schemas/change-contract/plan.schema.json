{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrid.local/schemas/change-contract/plan.schema.json",
  "title": "Plan",
  "description": "What a transaction did, or would do for a dry run (astrid/sdk/timeline/transaction.py Plan.to_json). Filled for every transaction. Digests use the same hash space as journal before/after.",
  "type": "object",
  "required": [
    "label",
    "calls",
    "changed",
    "changes",
    "diff",
    "clips",
    "cuts",
    "lint_delta",
    "blocking",
    "sweep",
    "digests"
  ],
  "additionalProperties": false,
  "properties": {
    "label": {
      "type": "string"
    },
    "calls": {
      "type": "array",
      "items": {
        "$ref": "opcall.schema.json"
      },
      "description": "What ran. Always [] until the operation runner lands."
    },
    "changed": {
      "type": "boolean"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Plain words, as check prints them."
    },
    "diff": {
      "type": "object",
      "description": "diff_bundles shape (timeline seconds) when changed; {} for a no-change or refused transaction (real output).",
      "properties": {
        "changes": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "present when the transaction changed the document"
        }
      }
    },
    "clips": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cuts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lint_delta": {
      "type": "object",
      "required": [
        "new",
        "resolved"
      ],
      "additionalProperties": false,
      "properties": {
        "new": {
          "type": "array"
        },
        "resolved": {
          "type": "array"
        }
      }
    },
    "blocking": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sweep": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "digests": {
      "type": "object",
      "required": [
        "before",
        "after"
      ],
      "additionalProperties": false,
      "properties": {
        "before": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "after": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
