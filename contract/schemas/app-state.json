{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrid.haus/workspace/v1/schemas/app-state.json",
  "title": "Actor-owned app state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scope",
    "actor_id",
    "key",
    "content",
    "version",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "scope": {
      "const": "user"
    },
    "actor_id": {
      "type": "string",
      "minLength": 1
    },
    "key": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "content": {
      "type": [
        "object",
        "null"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 0
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
