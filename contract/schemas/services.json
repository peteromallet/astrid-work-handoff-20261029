{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrid.haus/runtime/schemas/services.json",
  "title": "Profile service declaration",
  "description": "Runtime guarantees cleanup for descendants that remain in its supervised POSIX process group or Windows Job Object. If a service creates descendants outside that group, the service owns their lifecycle: stop them before exiting after stdin EOF or SIGTERM, and recover them on its next start after a crash. Runtime closes service stdin as the cooperative stop request on every OS, also sending SIGTERM on POSIX; after the grace period it forcibly cleans up the supervised group or Job.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "services"],
  "properties": {
    "version": {"const": 1},
    "services": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "argv", "restart"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
          "argv": {
            "type": "array", "minItems": 1, "maxItems": 256,
            "items": {"type": "string", "minLength": 1, "pattern": "^[^\u0000]*$"}
          },
          "env": {
            "type": "object",
            "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
            "additionalProperties": {"type": "string", "pattern": "^[^\u0000]*$"}
          },
          "restart": {"enum": ["always", "on-failure"]},
          "ready": {
            "type": "object", "additionalProperties": false,
            "required": ["file"],
            "properties": {
              "file": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"},
              "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 300, "default": 30}
            }
          }
        }
      }
    }
  }
}
