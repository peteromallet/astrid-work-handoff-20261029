{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrid.haus/contracts/public-boundary/1/diagnostic.schema.json",
  "title": "Astrid public diagnostic (C2 wire format)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractRevision",
    "contractDigest",
    "mode",
    "collectedAt",
    "timing",
    "problemCode",
    "failureBoundary",
    "facts",
    "limits",
    "captured",
    "truncated",
    "nextActions",
    "actionsExecuted",
    "redacted"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "contractRevision": {
      "const": "C2"
    },
    "contractDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "mode": {
      "enum": [
        "local",
        "shared"
      ]
    },
    "collectedAt": {
      "type": "string",
      "format": "date-time"
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deadlineScope",
        "deadlineMs",
        "elapsedMs",
        "timedOut"
      ],
      "properties": {
        "deadlineScope": {
          "const": "total-including-all-helpers"
        },
        "deadlineMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000
        },
        "elapsedMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000
        },
        "timedOut": {
          "type": "boolean"
        }
      }
    },
    "problemCode": {
      "enum": [
        null,
        "workspace_missing",
        "workspace_ambiguous",
        "workspace_identity_mismatch",
        "workspace_configured_runtime_not_ready",
        "runtime_unavailable",
        "runtime_identity_mismatch",
        "permission_limited",
        "active_work_requires_authorization",
        "capability_unavailable",
        "authorization_required",
        "provider_state_unknown",
        "observation_stale",
        "observation_timeout",
        "hosted_session_required",
        "contributor_link_unavailable"
      ]
    },
    "failureBoundary": {
      "enum": [
        null,
        "workspace-selection",
        "runtime-process-identity",
        "runtime-contact",
        "runtime-permission",
        "runtime-schema",
        "compute-readiness",
        "execution-authorization",
        "task-admission",
        "attempt-execution",
        "provider-observation",
        "diagnostic-observation"
      ]
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace",
        "runtime",
        "computeWorker",
        "selectedCapability",
        "authorization",
        "taskState",
        "contact",
        "progress",
        "terminalResult",
        "providerExecution",
        "providerBilling",
        "optionalContributionAuth",
        "hostedSessionAndGrants"
      ],
      "properties": {
        "workspace": {
          "$ref": "#/$defs/fact"
        },
        "runtime": {
          "$ref": "#/$defs/fact"
        },
        "computeWorker": {
          "$ref": "#/$defs/fact"
        },
        "selectedCapability": {
          "$ref": "#/$defs/fact"
        },
        "authorization": {
          "$ref": "#/$defs/fact"
        },
        "taskState": {
          "$ref": "#/$defs/fact"
        },
        "contact": {
          "$ref": "#/$defs/fact"
        },
        "progress": {
          "$ref": "#/$defs/fact"
        },
        "terminalResult": {
          "$ref": "#/$defs/fact"
        },
        "providerExecution": {
          "$ref": "#/$defs/fact"
        },
        "providerBilling": {
          "$ref": "#/$defs/fact"
        },
        "optionalContributionAuth": {
          "$ref": "#/$defs/fact"
        },
        "hostedSessionAndGrants": {
          "$ref": "#/$defs/fact"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxEvents",
        "maxLogBytes",
        "maxBundleBytes"
      ],
      "properties": {
        "maxEvents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        },
        "maxLogBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "maxBundleBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        }
      }
    },
    "captured": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "events",
        "logBytes",
        "bundleBytes"
      ],
      "properties": {
        "events": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        },
        "logBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "bundleBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        }
      }
    },
    "truncated": {
      "type": "boolean"
    },
    "nextActions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "actionsExecuted": {
      "type": "array",
      "maxItems": 0
    },
    "redacted": {
      "type": "boolean"
    }
  },
  "oneOf": [
    {
      "title": "healthy checked scope",
      "properties": {
        "problemCode": {
          "type": "null"
        },
        "failureBoundary": {
          "type": "null"
        }
      }
    },
    {
      "title": "observed failure",
      "properties": {
        "problemCode": {
          "type": "string",
          "minLength": 1
        },
        "failureBoundary": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  ],
  "$defs": {
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed",
        "value",
        "observedAt",
        "unavailableReason"
      ],
      "properties": {
        "observed": {
          "type": "boolean"
        },
        "value": {
          "type": [
            "string",
            "boolean",
            "number",
            "null"
          ]
        },
        "observedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "unavailableReason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "observed": {
              "const": true
            },
            "value": {
              "type": [
                "string",
                "boolean",
                "number"
              ]
            },
            "observedAt": {
              "type": "string",
              "format": "date-time"
            },
            "unavailableReason": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "observed": {
              "const": false
            },
            "value": {
              "type": "null"
            },
            "observedAt": {
              "type": "null"
            },
            "unavailableReason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commandId",
        "arguments",
        "effects",
        "authorizationRequired",
        "executable"
      ],
      "properties": {
        "commandId": {
          "type": "string",
          "minLength": 1
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "effects": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "authorizationRequired": {
          "type": "boolean"
        },
        "executable": {
          "type": "boolean"
        }
      },
      "oneOf": [
        {
          "properties": {
            "commandId": {
              "const": "setup-preview"
            },
            "effects": {
              "const": [
                "observe"
              ]
            }
          }
        },
        {
          "properties": {
            "commandId": {
              "const": "setup-check"
            },
            "effects": {
              "const": [
                "observe"
              ]
            }
          }
        },
        {
          "properties": {
            "commandId": {
              "const": "setup-apply"
            },
            "effects": {
              "const": [
                "configure-install",
                "write-relocate-change-data",
                "start-stop-local-service"
              ]
            },
            "authorizationRequired": {
              "const": true
            }
          }
        },
        {
          "properties": {
            "commandId": {
              "const": "runtime-up"
            },
            "effects": {
              "const": [
                "start-stop-local-service",
                "configure-install",
                "write-relocate-change-data"
              ]
            },
            "authorizationRequired": {
              "const": true
            }
          }
        },
        {
          "properties": {
            "commandId": {
              "const": "runtime-status"
            },
            "effects": {
              "const": [
                "observe"
              ]
            }
          }
        },
        {
          "properties": {
            "commandId": {
              "const": "doctor"
            },
            "effects": {
              "const": [
                "observe"
              ]
            }
          }
        },
        {
          "properties": {
            "commandId": {
              "const": "workspace-status"
            },
            "effects": {
              "const": [
                "observe"
              ]
            }
          }
        },
        {
          "properties": {
            "commandId": {
              "const": "auth-status"
            },
            "effects": {
              "const": [
                "observe"
              ]
            }
          }
        },
        {
          "properties": {
            "commandId": {
              "const": "auth-login"
            },
            "effects": {
              "const": [
                "configure-install",
                "write-relocate-change-data"
              ]
            },
            "authorizationRequired": {
              "const": true
            }
          }
        },
        {
          "properties": {
            "commandId": {
              "const": "auth-logout"
            },
            "effects": {
              "const": [
                "write-relocate-change-data"
              ]
            },
            "authorizationRequired": {
              "const": true
            }
          }
        },
        {
          "properties": {
            "commandId": {
              "const": "auth-revoke"
            },
            "effects": {
              "const": [
                "write-relocate-change-data"
              ]
            },
            "authorizationRequired": {
              "const": true
            }
          }
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "arguments": {
                "contains": {
                  "type": "string",
                  "pattern": "(?:<|\\[)[rR][eE][dD][aA][cC][tT][eE][dD]"
                }
              }
            }
          },
          "then": {
            "properties": {
              "executable": {
                "const": false
              }
            }
          }
        }
      ]
    }
  },
  "description": "Public boundary bundle 1.x. Cross-field bounds and shared-content redaction are also checked by the behavioral fixtures.",
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "shared"
          }
        }
      },
      "then": {
        "properties": {
          "redacted": {
            "const": true
          },
          "nextActions": {
            "items": {
              "properties": {
                "executable": {
                  "const": false
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "redacted": {
            "const": false
          }
        }
      }
    }
  ]
}
